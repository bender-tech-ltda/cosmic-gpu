# ----------------------------------------------------------------------------
# Cosmic GPU Cloud — environment variables
# Copy this file to `.env` (or `apps/<name>/.env`) and fill in real values.
# ----------------------------------------------------------------------------

# ---------- Backend ----------
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
BACKEND_LOG_LEVEL=info

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Per-API-key rate limit (requests per minute)
RATE_LIMIT_RPM=60

# Maximum HTTP request body size in bytes (default 1 MiB).
BACKEND_BODY_LIMIT_BYTES=1048576

# HMAC secret for API-key hashing (set a strong random value).
# Generate: openssl rand -hex 32
# Leave empty for dev/tests — the backend falls back to a clearly-flagged
# placeholder. Required to be set explicitly when NODE_ENV=production.
API_KEY_HMAC_SECRET=

# ---------- Worker ----------
WORKER_ID=worker-local
WORKER_LOG_LEVEL=info

# How often a worker considers itself "alive". The backend dispatcher polls
# `worker.health` on each connection and may soft-remove workers that miss
# multiple consecutive heartbeats.
WORKER_HEARTBEAT_INTERVAL_MS=10000

# Maximum concurrent inference jobs the worker advertises in `worker.health`.
WORKER_CAPACITY=4

# Model id served by this worker (mock LLM for the take-home).
WORKER_MODEL_ID=mock-llm

# Mock-LLM tuning: synthetic token rate (Hz) and hard cap on tokens per job.
MOCK_LLM_TOKEN_RATE_HZ=25
MOCK_LLM_MAX_TOKENS=64

# ---------- P2P (shared by backend + worker) ----------
# 32-byte topic, base64-encoded. All peers in the swarm MUST share the same topic.
# Leave empty to use the built-in deterministic dev topic (safe for local demos
# and the Compose stack — every node falls back to the same default).
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
P2P_DISCOVERY_TOPIC=

# Optional comma-separated list of `host:port` HyperDHT bootstrap nodes.
# Leave EMPTY here — Docker Compose substitutes the in-Compose `dht:49737`
# bootstrap by default. Set this explicitly only when running natively against
# the public Holepunch DHT or a custom bootstrap (e.g. P2P_BOOTSTRAP=dht.example:49737).
P2P_BOOTSTRAP=

# Path to persisted node identity SEED (32 bytes). The seed is the only
# material on disk; the real ed25519 keypair is derived at boot via
# HyperDHT.keyPair(seed). Will be created on first boot.
NODE_KEYPAIR_PATH=./data/node.keypair

# Local data directory for Hypercore / HyperDB
DATA_DIR=./data

# State backend selector. `hyperbee` is the production backend (Hyperbee on
# Hypercore on disk). `memory` is for tests/dev only.
STATE_BACKEND=hyperbee

# ---------- Frontend ----------
VITE_BACKEND_URL=http://localhost:3000
