{
  "name": "cosmic-take-home",
  "version": "0.0.0",
  "private": true,
  "description": "Distributed GPU Cloud Service Platform - Tether Senior Fullstack Engineer take-home",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @cosmic/shared build",
    "test": "vitest",
    "test:run": "pnpm build:shared && vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
