    "protomux": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "pino-pretty": "^11.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
