{
  "name": "@cosmic/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest",
    "lint": "eslint --no-error-on-unmatched-pattern src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cosmic/shared": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/type-provider-typebox": "^6.0.0",
    "@hyperswarm/rpc": "^3.4.0",
    "@sinclair/typebox": "^0.34.0",
    "compact-encoding": "^3.0.0",
    "envalid": "^8.0.0",
    "fastify": "^5.0.0",
    "hyperdb": "^6.0.0",
    "hyperswarm": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vitest-mock-extended": "^2.0.0"
  }
}
